# Public browser-safe project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Server-only key. Never expose this in client components or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=

# Solana/RPC provider configuration.
SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=
SOLANA_WS_URL=
YELLOWSTONE_GRPC_URL=

# Privacy provider configuration. Keep provider credentials server-side.
PRIVACY_PROVIDER=mock
NEXT_PUBLIC_ENABLE_CLOAK=false
CLOAK_API_URL=
MAGICBLOCK_PAYMENTS_API_URL=
MAGICBLOCK_TEE_RPC_URL=
MAGICBLOCK_PUSD_MINT=
MAGICBLOCK_USDC_MINT=
NEXT_PUBLIC_MAGICBLOCK_TEST_AMOUNT_MINOR=
NEXT_PUBLIC_DEMO_RECIPIENT_WALLET=
UMBRA_INDEXER_API_URL=

# Data and analytics integrations.
DUNE_SIM_API_KEY=
# Raw Solana base58 public key only. Do not use .sol names or EVM 0x addresses.
DUNE_SIM_WALLET_ADDRESS=
GOLDRUSH_API_KEY=

# Local-only QVAC runtime. Leave empty to use deterministic fallback.
# Example when `pnpm --filter @veilsettle/web qvac:serve` is running:
# QVAC_BASE_URL=http://127.0.0.1:11434/v1
# QVAC_MODEL=qvac-local-invoice-review
QVAC_BASE_URL=
QVAC_MODEL=

# Growth and agent integrations.
TORQUE_API_KEY=
TORQUE_API_TOKEN=
ZERION_API_KEY=
